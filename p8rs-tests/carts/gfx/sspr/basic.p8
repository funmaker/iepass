sspr(0, 0, 16, 16, 64, 48, 16, 16, true)
palt(4, true)
sspr(0, 0, 16, 16, 64, 64, 16, 16, true, true)
palt(5, true)
sspr(0, 0, 16, 16, 48, 64, 16, 16, false, true)
