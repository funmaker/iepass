sspr(64, 24, 32, 32, 80, 80, 32, 32)
sspr(96, 24, 32, 32, 16, 80, 32, 32)
p8rs.test_scr("basic");

cls()
sspr(0, 0, 16, 16, 10, 10, 106, 106)
