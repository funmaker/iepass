pico-8 cartridge // http://www.pico-8.com
version 43

__lua__

cls()
for y = 0,8 do
  for x = 0,8 do
    xfs = (x & 0b001) >> 0
    xfd = (x & 0b010) >> 1
    xff = (x & 0b100) != 0
    yfs = (y & 0b001) >> 0
    yfd = (y & 0b010) >> 1
    yff = (y & 0b100) != 0
    sspr(
      0 + xfs * 16, 0 + yfs * 16,
      16 - xfs * 32, 16 - yfs * 32,
      x * 16 + xfd * 16, y * 16 + yfd * 16,
      16 - xfd * 32, 16 - yfd * 32,
      xff, yff
    )
  end
end
p8rs.test_scr("flips");

for o = 1, 16 do
  cls()
  for y = 0,8 do
    for x = 0,8 do
      xfs = (x & 0b001) >> 0
      xfd = (x & 0b010) >> 1
      xff = (x & 0b100) != 0
      yfs = (y & 0b001) >> 0
      yfd = (y & 0b010) >> 1
      yff = (y & 0b100) != 0
      sspr(
        -o + xfs * 16, -o + yfs * 16,
        16 - xfs * 32 + o, 16 - yfs * 32 + o,
        x * 16 + xfd * 16, y * 16 + yfd * 16,
        16 - xfd * 32, 16 - yfd * 32,
        xff, yff
      )
    end
  end
  p8rs.test_scr("clipflips " .. o);
end

for o = 1, 16 do
  cls()
  for y = 0,8 do
    for x = 0,8 do
      xfs = (x & 0b001) >> 0
      xfd = (x & 0b010) >> 1
      xff = (x & 0b100) != 0
      yfs = (y & 0b001) >> 0
      yfd = (y & 0b010) >> 1
      yff = (y & 0b100) != 0
      sspr(
        -o + xfs * 7, -o + yfs * 7,
        7 - xfs * 14 + o, 7 - yfs * 14 + o,
        x * 16 + xfd * 16, y * 16 + yfd * 16,
        16 - xfd * 32, 16 - yfd * 32,
        xff, yff
      )
    end
  end
  p8rs.test_scr("clipflips up " .. o);
end

cls()
for y = 0,8 do
  for x = 0,8 do
    xfs = (x & 0b001) >> 0
    xfd = (x & 0b010) >> 1
    xff = (x & 0b100) != 0
    yfs = (y & 0b001) >> 0
    yfd = (y & 0b010) >> 1
    yff = (y & 0b100) != 0
    sspr(
      120 + xfs * 16, 120 + yfs * 16,
      16 - xfs * 32, 16 - yfs * 32,
      x * 16 + xfd * 16, y * 16 + yfd * 16,
      16 - xfd * 32, 16 - yfd * 32,
      xff, yff
    )
  end
end
p8rs.test_scr("clipflips end");

