-- memory debug

function hex_byte(val)
    return sub(tostr(val, true), 5, 6)
end

function format_addr(addr)
    return "[" .. sub(tostr(addr, 1), 1, 6) .. "]: "
end

function memory_around(base)
    for i = -2, 2, 1 do

        print(format_addr(base + i) .. "0x" .. hex_byte(peek(base + i)))
    end
end

function memory_stride(base, stride, count)
    for i = 0, count-1 do
        local addr = base + i * stride
        print(format_addr(addr) .. hex_byte(peek(addr)) .. hex_byte(peek(addr+1)) .. hex_byte(peek(addr+2)) .. hex_byte(peek(addr+3)))
    end
end

