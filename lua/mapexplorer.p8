pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
for i = 0x8000,0xffff,2 do
  poke(i, (i >>> 8) & 0xff, i & 0xff)
end

poke(0x5f56, 0x20)
poke(0x5f57, 128)

x=-2
y=-1

function _draw()
	cls()
	map(x, y,  0,  0, 16, 16)
	rectfill(0,0,15,128,0)
	rectfill(0,0,128,7,0)
	for xx=2,16 do
		if x+xx >= 0 and x+xx <= 255 then
	  print(sub(tostr(x+xx,true),5,6),xx*8,0,(x+xx)%2==0 and 6 or 7)
	 end
	end
	for yy=1,16 do
  print(sub(tostr(y+yy,true),3,6),max(0,(-2-x))*8,yy*8,(y+yy)%2==0 and 6 or 7)
	end
end

function _update()
	function b2n(b) return btn(b) and 1 or 0 end
	s=(b2n(🅾️)*7+1)*(b2n(❎)*63+1)
	x+=(b2n(➡️)-b2n(⬅️))*s
	y+=(b2n(⬇️)-b2n(⬆️))*s
end

