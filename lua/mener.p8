pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
menel_names = {"anzej", "buchaj", "chono", "dej", "eustachy", "franek", "gierwald", "heniek", "ignacy", "juzek", "kazik", "lemen", "marskosc", "najeban", "opijak", "pijak", "rychu", "spity", "topijak", "upity", "wypity", "x-menel", "zdzichu"}
	
function _init()
	music(00)
	muzyka = 1
 score = 0
 money = 10
 game_time = 100
 menel_name = rnd(menel_names)
 col = 5
 option = 1
 hp = 69
 atk = 5
 hits = 3
	menel_index = 1
	battle_index = 1
 menels = {{9999,1}}
 battle_log = {{0,0,0},{0,0,0}}
 for i=1,4 do
 	add_menel()
 end
 current_function = "main"
	current_text = "wybierz jakoms opcje"
	current_text2 = "tekst dolny"
end

function _update()
	if hp < 0 then
		music(-1)
		current_function = "gameover"
		current_text = "game over ●█😐░ 🅾️ˇ░➡️"
		if (btnp(❎)) _init()
		if (btnp(🅾️)) current_text2 = "⬇️▥☉░⌂☉"
	end
	if game_time < 0 then
		current_function = "gameover"
		current_text = "congratulations, you lost!"
		current_text2 = "your score is: "..score.." melin."
		if (btnp(❎)) _init()
		if (btnp(🅾️)) current_text2 = "⬇️▥☉░⌂☉"
	end
	if (current_function=="main") then
		option_changer()
	end
		if (current_function=="show_menels") then
  show_menels()
		if (btnp(❎)) current_option="main"
	end
		if (current_function=="battle_menels") then
  show_battle()
		if (btnp(❎)) current_option="main"
	end
	if (current_function=="drink_hrnx") then
  show_battle()
		if (btnp(❎)) current_option="main"
	end
		if (current_function=="drink_hrnx") then
  drink_hrnx()
		if (btnp(❎)) current_option="main"
	end		
	if (current_function=="no_money") then
  no_money()
		if (btnp(❎)) current_option="main"
	end
	if (current_function=="drink_rmpr") then
  drink_rmpr()
		if (btnp(❎)) current_option="main"
	end
	if (current_function=="drink_vp") then
  drink_vp()
		if (btnp(❎)) current_option="main"
	end
end

function _draw()
 cls()
 draw_plansze()
 print(current_text,6,100)
 print(current_text2,6,108)
end

function option_changer()
	--cursor manipulation
	if (btnp(⬆️)) 
		then
		sfx(04)
		if (option > 1)
			then
			option=option-1
		end
	end
	if (btnp(⬇️)) 
		then
		sfx(04)
		if (option < 6)
			then
			option=option+1
		end
	end
	--music toggle
	if (btnp(➡️))
		then
		if (muzyka == 1)
			then
			muzyka = 0
			music(-1)
		else
			muzyka = 1
			music(00)
		end
	end
	--option chosing
	if (btnp(🅾️)) and option==1 then
		sfx(05)
		game_time-=1
	 battle_menels()
	end
	if (btnp(🅾️)) and option==2 then
		sfx(05)
		game_time-=1
	 add_menel()
	end 
	if (btnp(🅾️)) and option==3 then
		sfx(05)
		game_time-=1
 	show_menels()
 end
 if (btnp(🅾️)) and option==4 then
 	sfx(05)
 	if money < 0 then
 		no_money()
 	else
			game_time-=1	
			hp+=flr(rnd(15))+5
			money-=10
 		drink_hrnx()
 	end
 end
  if (btnp(🅾️)) and option==5 then
 	sfx(05)
 	if money < 0 then
 		no_money()
 	else
 		game_time-=1	
			atk+=flr(rnd(5))+1
			money-=20
 		drink_rmpr()
 		end
 	end
 	if (btnp(🅾️)) and option==6 then
 	sfx(05)
 	if money < 0 then
 		no_money()
 	else
 		game_time-=1	
			hits+=1
			money-=30
 		drink_vp()
 		end
 	end
end

function no_money()
	current_function="no_money"
	current_text="you are poor menel..."
	current_text2="do you want some orange?"
		if (btnp(❎)) then
		sfx(06)
		reset_text()
		current_function="main"
	end
end

function drink_hrnx()
	current_function="drink_hrnx"
	current_text="you drink hrnx, so refreshing!"
	current_text2="time to beat some more ass..."
	if (btnp(❎)) then
		sfx(06)
		reset_text()
		current_function="main"
	end
end

function drink_rmpr()
	current_function="drink_rmpr"
	current_text="you drink rmpr, feeling mighy!"
	current_text2="they shall fear me..."
	if (btnp(❎)) then
		sfx(06)
		reset_text()
		current_function="main"
	end
end

function drink_vp()
	current_function="drink_vp"
	current_text="you drink v.p., wsciekle..."
	current_text2="piesci weza, drugie uderzenie."
	if (btnp(❎)) then
		sfx(06)
		reset_text()
		current_function="main"
	end
end


-->8
function draw_plansze()
 logo()
 header()
 footer()
 game_field()
 status_bar()
 event_bar()
 player_status_bar()
 option_arrow()
end

function option_arrow()
	x = 5
	y = 34 + option * 8
	spr(10,x,y)
end

function logo()
	t1 = t()*30 - col
	x = 3.25*8     +cos(t1/90)*3
	y = 4+cos(t1/50)*3
	
	print("menel fajter v0.2",x,y,6)
	print("wersja z muzykom★",x,y+7)
end

function header()
	x = 0
	y = 20
	spr(1,x,y)
	spr(3,x,y+8)
	for i = 1,14 do
		spr(5,x+(i*8),y)
	end
	spr(6,x+120,y)
	spr(7,x+120,y+8)
	for i = 1,14 do
		spr(4,x+(i*8),y+8)
	end
	print("😐:"..menel_name, x+10, y+6)
	print("⧗:"..game_time, x+64, y+6)
	print("★:"..score, x+94, y+6)
end--header

function footer()
	x = 0
	y = 94
	spr(1,x,y)
	spr(2,x,y+8)
	spr(3,x,y+16)
	for i = 1,14 do
		spr(5,x+(i*8),y)
	end
	spr(6,x+120,y)
	spr(8,x+120,y+8)
	spr(7,x+120,y+16)
	for i = 1,14 do
		spr(4,x+(i*8),y+16)
	end
end--footer

function game_field()
 x=0
 y=37
	print("- hit  menel",x+7,y+6)
	print("- add  menel",x+7,y+14)
	print("- show menel",x+7,y+22)
	print("- drink hrnx 10",x+7,y+30)
	print("- drink rmpr 20",x+7,y+38)
	print("- drink v.p. 30",x+7,y+46)
	spr(1,x,y)
	for i = 1,5 do
		spr(2,x,y+(i*8))
	end
	spr(3,x,y+48)
	for i = 1,7 do
		spr(5,x+(i*8),y)
	end
	spr(6,x+64,y)
	for i = 1,5 do
		spr(8,x+64,y+(i*8))
	end
	spr(7,x+64,y+48)
	for i = 1,7 do
		spr(4,x+(i*8),y+48)
	end
end--game_field

function status_bar()
	x=73
	y=69
	print("●money:"..money,x+5,y+5)
	print("웃menels:"..count(menels),x+5,y+14)
	spr(1,x,y)
	spr(2,x,y+8)
	spr(3,x,y+16)
	for i = 1,5 do
		spr(5,x+(i*8),y)
	end
	for i = 1,5 do
		spr(4,x+(i*8),y+16)
	end
	spr(8,x+47,y+8)
	spr(6,x+47,y)
	spr(7,x+47,y+16)
end--status_bar

function event_bar()
	x=73
	y=37
	spr(12,x+5,y+4)
	spr(13,x+13,y+4)
	spr(28,x+5,y+12)
	spr(29,x+13,y+12)
	spr(30,x+21,y+12)
	spr(44,x+5,y+20)
	spr(45,x+13,y+20)
	spr(1,x,y)
	for i = 1,2 do
		spr(2,x,y+(i*8))
	end
	spr(3,x,y+23)
	spr(5,x+8,y)
	spr(5,x+12,y)
	spr(6,x+19,y)
	for i = 1,2 do
	spr(8,x+19,y+(i*8))
	end
	spr(7,x+19,y+23)
	spr(4,x+8,y+23)
	spr(4,x+12,y+23)
end--event_bar



function player_status_bar()
	x=101
	y=37
	print("♥:"..hp,x+4,y+6)
	print("✽:"..atk,x+4,y+13)
	print("ˇ:"..hits,x+4,y+20)
		spr(1,x,y)
	for i = 1,2 do
		spr(2,x,y+(i*8))
	end
	spr(3,x,y+23)
	spr(5,x+8,y)
	spr(5,x+12,y)
	spr(6,x+19,y)
	for i = 1,2 do
	spr(8,x+19,y+(i*8))
	end
	spr(7,x+19,y+23)
	spr(4,x+8,y+23)
	spr(4,x+12,y+23)
end


-->8
function reset_text()
	current_text = "menele never ends!"
	current_text2 = "fight them!"
end

function add_menel()
	add(menels,{flr(rnd(20))+1,flr(rnd(3))+1})
end

function show_menels()
	current_function="show_menels"
	if menel_index < count(menels) and (btnp(⬆️)) then
		sfx(07)
		menel_index+=1
	end
	if menel_index > 1 and (btnp(⬇️)) then
		sfx(07)
  menel_index-=1
 end
	current_text="details of menel "..menel_index
	current_text2="hp:"..menels[menel_index][1].." atk:"..menels[menel_index][2]
	if (btnp(❎)) then
		sfx(06)
		reset_text()
		current_function="main"
	end
end

-->8

function battle_menels()
 battle_log = {}
	current_function="battle_menels"

		for i=1,hits do	
			current_menel=flr(rnd(count(menels)))+1
			add(battle_log,{current_menel,flr(rnd(atk)), flr(rnd(menels[current_menel][2])+rnd(5))})
			hp -= menels[current_menel][2]
			menels[current_menel][1] -= flr(rnd(atk)+rnd(5))
			if (menels[current_menel][1]) < 0 then
			 del(menels,menels[current_menel])
			 money+=10+flr(rnd(5))
			 score+=1*count(menels)
			end
		end
end

function show_battle()
	if battle_index < count(battle_log) and (btnp(⬆️)) then
		sfx(07)
		battle_index+=1
	end
	if battle_index > 1 and (btnp(⬇️)) then
  sfx(07)
  battle_index-=1
 end
 current_text="fight "..battle_index.." with menel "..battle_log[battle_index][1]
	current_text2="you hit for:"..battle_log[battle_index][2].." menel hit for:"..battle_log[battle_index][3]
	if (btnp(❎)) then
		sfx(06)
		reset_text()
		current_function="main"
	end
end

